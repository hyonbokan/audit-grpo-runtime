# This host's settings for the launchers. Copy to host.env (git-ignored) on each GPU host;
# launch-lib.sh refuses to start without it. Image tags and the workspace path are in code.

# Absolute cache directory: HF_HOME (<cache>/huggingface), merges, run artifacts, wheels.
AUDIT_GRPO_CACHE=

# GPU peer access: "enabled", or "disabled" when preflight.sh finds peer copies corrupt (seen
# with the IOMMU translating between PCIe root ports). Disabled stages copies through host RAM.
AUDIT_GRPO_PEER_ACCESS=

# Private Hugging Face model repository (owner/name) for run backups; launch-segment.sh needs it.
# The upload token comes from the credentials file, never from here.
AUDIT_GRPO_HF_REPO=
