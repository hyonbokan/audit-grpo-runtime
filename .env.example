# Copy into a restricted file (chmod 600) and point configs at it; never commit real values.

# Judge gateway. Named by `judge_env_file` in a run config and read inside the live judge
# container; grading stops if either value is missing.
LITELLM_GATEWAY_URL=
LITELLM_GATEWAY_API_KEY=

# Private Hugging Face backups (hf_backup.py via `hf_env_file`, backup-tools via --dotenv).
# Needs write access to the private backup repository named by `hf_repo`.
HF_TOKEN=
